# Database Configuration
# Development için varsayılan değerler (admin/admin)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=fastapi_db

# Database URL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://admin:admin@db:5432/fastapi_db

# JWT Configuration
# Yeni SECRET_KEY oluşturmak için terminal'de şu komutu çalıştırın:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=FastAPI CRUD API
DEBUG=True
